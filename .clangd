CompileFlags:
  CompilationDatabase: .
  Add:
    - --target=x86_64-linux-gnu
    - -std=c++20
    - -I${workspaceFolder}/src/libfluidcore
    - -I${workspaceFolder}/src/app
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include/c++/15
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include/x86_64-linux-gnu/c++/15
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include/c++/15/backward
    - -isystem
    - //wsl.localhost/Ubuntu/usr/lib/gcc/x86_64-linux-gnu/15/include
    - -isystem
    - //wsl.localhost/Ubuntu/usr/local/include
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include/x86_64-linux-gnu
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include/gtk-3.0
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include/glib-2.0
    - -isystem
    - //wsl.localhost/Ubuntu/usr/lib/x86_64-linux-gnu/glib-2.0/include
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include/pango-1.0
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include/cairo
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include/gdk-pixbuf-2.0
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include/atk-1.0
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include/poppler/glib
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include/poppler
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include/harfbuzz
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include/freetype2
    - -isystem
    - //wsl.localhost/Ubuntu/usr/include/pixman-1
