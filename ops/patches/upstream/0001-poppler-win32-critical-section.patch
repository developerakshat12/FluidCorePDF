--- /dev/null
+++ b/poppler/PopplerMutex.h
@@ -0,0 +1,63 @@
+//========================================================================
+//
+// PopplerMutex.h
+//
+// Cross-platform recursive mutex wrapper.
+// Uses native Win32 CRITICAL_SECTION on Windows to eliminate libwinpthread
+// handle leaks, and std::recursive_mutex on other platforms.
+//
+//========================================================================
+
+#ifndef POPPLER_MUTEX_H
+#define POPPLER_MUTEX_H
+
+#include <mutex>
+
+#if defined(_WIN32)
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+
+namespace poppler_internal {
+
+class RecursiveMutex {
+public:
+    RecursiveMutex() {
+        InitializeCriticalSectionAndSpinCount(&cs_, 4000);
+    }
+    ~RecursiveMutex() {
+        DeleteCriticalSection(&cs_);
+    }
+    RecursiveMutex(const RecursiveMutex&) = delete;
+    RecursiveMutex& operator=(const RecursiveMutex&) = delete;
+
+    void lock() {
+        EnterCriticalSection(&cs_);
+    }
+    void unlock() {
+        LeaveCriticalSection(&cs_);
+    }
+    bool try_lock() {
+        return TryEnterCriticalSection(&cs_) != 0;
+    }
+
+private:
+    CRITICAL_SECTION cs_;
+};
+
+} // namespace poppler_internal
+
+using PopplerRecursiveMutex = poppler_internal::RecursiveMutex;
+
+#else
+
+using PopplerRecursiveMutex = std::recursive_mutex;
+
+#endif
+
+#endif // POPPLER_MUTEX_H
